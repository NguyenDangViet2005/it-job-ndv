# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Integration tests require a separate local database with a test name.
DATABASE_TEST_URL="postgresql://itjob:itjob_test_123@localhost:5433/it_job_test"

# Step 1: Redis cache for Location only. Omit REDIS_URL to use DB directly.
REDIS_URL="redis://localhost:6379"
# Enable HIT / MISS / BYPASS logs while learning.
REDIS_CACHE_DEBUG=false
